{
  "pdf": "D:\\path\\to\\your-scanned-book.pdf",
  "out_dir": "D:\\path\\to\\output-folder",

  "provider": {
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "api_key": "在这里填你的 API Key（或改用环境变量 VISION_API_KEY）",
    "model": "qwen-vl-max",
    "headers": {}
  },

  "review": {
    "base_url": "",
    "api_key": "",
    "model": "",
    "headers": {}
  },

  "dpi": 170,
  "concurrency": 6,
  "max_retries": 3,
  "timeout": 240,
  "max_tokens": 8000,
  "extra_body": {},

  "skip_front_matter": true,
  "start_page": null,
  "toc_scan_limit": 30,
  "toc_max_pages": 6,
  "auto_chapters": false,

  "use_text_layer": true,
  "text_layer_min_chars": 30,
  "requality": true,
  "requality_min_chars": 30,
  "requality_dpi_boost": 1.4,
  "figures": false,

  "cleanup": "llm",
  "cleanup_repeat_ratio": 0.3,
  "cleanup_min_pages": 5,

  "chapters": [
    { "name": "第一章 绪论", "from": 1, "to": 72 },
    { "name": "第二章 线性表", "from": 73, "to": 140 }
  ]
}
